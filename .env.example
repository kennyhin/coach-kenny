# Required. Checked only on the server. A 4-digit value is light protection.
TRANSCRIBER_PIN=

# Vercel Blob read-write token. Required when the API runs on Vercel.
# Create a private Blob store and connect it to the project; Vercel injects this.
BLOB_READ_WRITE_TOKEN=

# Optional. Without it, Chrome live captions (microphone) and an in-browser
# model (shared tab audio) still transcribe. Set this for clearer hour-long
# tab/system audio. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini-transcribe. whisper-1 is the fallback.
OPENAI_TRANSCRIBE_MODEL=
