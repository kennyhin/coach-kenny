# Passcode Kenny types to edit the Fun Friday lineup.
# Checked only on the server. Set it for Production and Preview on the Vercel project.
FUNFRIDAY_PASSCODE=

# Vercel Blob injects this when a Blob store is connected to the project.
# Do not commit a real token. Public stores use this token.
# Private stores use BLOB_STORE_ID plus Vercel's OIDC token instead.
BLOB_READ_WRITE_TOKEN=
